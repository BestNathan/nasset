{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageNassetRuntimeIAMRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::REPLACE_WITH_12_DIGIT_ACCOUNT_ID:role/nasset-deribit-lambda-role",
        "arn:aws:iam::REPLACE_WITH_12_DIGIT_ACCOUNT_ID:role/nasset-deribit-scheduler-role"
      ]
    },
    {
      "Sid": "PassOnlyNassetRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::REPLACE_WITH_12_DIGIT_ACCOUNT_ID:role/nasset-deribit-lambda-role",
        "arn:aws:iam::REPLACE_WITH_12_DIGIT_ACCOUNT_ID:role/nasset-deribit-scheduler-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ManageNassetDispatcherLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:DeleteFunction"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-2:REPLACE_WITH_12_DIGIT_ACCOUNT_ID:function:nasset-deribit-github-dispatcher"
    },
    {
      "Sid": "ManageNassetHourlySchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:ap-southeast-2:REPLACE_WITH_12_DIGIT_ACCOUNT_ID:schedule/default/nasset-deribit-hourly"
    },
    {
      "Sid": "ManageNassetGitHubSSMSecureString",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-2:REPLACE_WITH_12_DIGIT_ACCOUNT_ID:parameter/nasset/deribit/github-token"
    },
    {
      "Sid": "ManageNassetDispatcherCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:REPLACE_WITH_12_DIGIT_ACCOUNT_ID:log-group:/aws/lambda/nasset-deribit-github-dispatcher",
        "arn:aws:logs:ap-southeast-2:REPLACE_WITH_12_DIGIT_ACCOUNT_ID:log-group:/aws/lambda/nasset-deribit-github-dispatcher:*"
      ]
    }
  ]
}
